# --- Local backend (server.py) ---
# Postgres from docker-compose.yml
DATABASE_URL=postgresql+psycopg://britestack:britestack_local@localhost:5439/britestack
# Skip Google OAuth locally: /auth/login signs you in as this address
DEV_LOGIN_EMAIL=dylanne.crugnale@brite.co
# Google OAuth (prod values live in Cloud Build substitutions, not here)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FLASK_SECRET_KEY=dev-only
# BigQuery jobs run here; source data is read from britecreations.Security_Collection
BQ_JOB_PROJECT=ai-tools-484419

# --- Vite build (legacy Firebase config, still passed as build args) ---
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
